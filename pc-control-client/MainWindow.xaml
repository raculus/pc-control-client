<Window
    x:Class="pc_control_client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PC 시간"
    Closed="Window_Closed">

    <Grid x:Name="RootGrid" Width="280" Height="380" Padding="16,32,36,16">
        <Grid.RowDefinitions>
            <!-- 0. 남은 시간 및 설정 버튼 영역 -->
            <RowDefinition Height="Auto"/>
            <!-- 1. 음성 알림 설정 영역 -->
            <RowDefinition Height="Auto"/>
            <!-- 2. 볼륨 조절 영역 -->
            <RowDefinition Height="Auto"/>
            <!-- 3. 테스트 버튼 영역 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. 남은 시간 정보 및 설정 버튼 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <!-- 설정 버튼 (좌측 상단 배치 - 기존 UI 요소가 우측 정렬이므로) -->
            <Button HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Padding="4" 
                    Background="Transparent" 
                    BorderThickness="0">
                <FontIcon Glyph="&#xE713;" FontSize="14"/>
                <Button.Flyout>
                    <Flyout x:Name="ApiSettingsFlyout">
                        <StackPanel Spacing="8" Width="220">
                            <TextBlock Text="API 주소 설정" FontWeight="Bold" FontSize="12"/>
                            <TextBox x:Name="TxtApiUrl" 
                                     Header="서버 URL" 
                                     PlaceholderText="http://localhost:3000"/>
                            <Button Content="저장 및 적용" 
                                    HorizontalAlignment="Stretch" 
                                    Click="BtnSaveApiUrl_Click"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- 메인 시간 표시 -->
            <StackPanel Spacing="2" HorizontalAlignment="Right">
                <TextBlock x:Name="TxtClientName"
                           Text="사용 시간" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Right" 
                           Foreground="{ThemeResource SystemChromeWhiteColor}"/>
                <TextBlock x:Name="TxtUptime" 
                           Text="사용 시간: -시간 -분" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Right" 
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                <TextBlock Text="남은 시간" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Right" 
                           Margin="0,4,0,0"
                           Foreground="{ThemeResource SystemChromeWhiteColor}"/>
                <TextBlock x:Name="TxtRemainingTime" 
                           Text="남은 시간: -시간 -분" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Right" 
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- 1. 알림 체크박스 -->
        <StackPanel Grid.Row="1" Spacing="6" HorizontalAlignment="Right" Margin="0,4,0,0">
            <TextBlock Text="음성 알림 설정" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

            <StackPanel Spacing="4">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                    <CheckBox x:Name="Chk30Min" Content="30분" IsChecked="True" Click="OnAlertSettingChanged" MinWidth="0"/>
                    <CheckBox x:Name="Chk15Min" Content="15분" IsChecked="False" Click="OnAlertSettingChanged" MinWidth="0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                    <CheckBox x:Name="Chk10Min" Content="10분" IsChecked="True" Click="OnAlertSettingChanged" MinWidth="0"/>
                    <CheckBox x:Name="Chk5Min" Content="5분" IsChecked="False" Click="OnAlertSettingChanged" MinWidth="0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- 2. 볼륨 조절 슬라이더 -->
        <StackPanel Grid.Row="2" Spacing="2" Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="알림 볼륨" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock x:Name="TxtVolumeValue" Text="80%" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            </Grid>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE767;" FontSize="14" Margin="0,0,8,0" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <Slider x:Name="SldVolume" 
                        Grid.Column="1" 
                        Minimum="0" 
                        Maximum="100" 
                        Value="80" 
                        StepFrequency="5"
                        MinHeight="0"
                        Padding="0"
                        Margin="0,-4,0,-4"
                        ValueChanged="SldVolume_ValueChanged"/>
            </Grid>
        </StackPanel>

        <!-- 3. 테스트 버튼 -->
        <Button Grid.Row="3" 
                Content="음성 알림 테스트" 
                HorizontalAlignment="Stretch" 
                Padding="0,6,0,6"
                Margin="0,12,0,0" 
                Click="BtnTestAudio_Click"/>
    </Grid>
</Window>